# Servidor
PORT=3000
NODE_ENV=development
# Orígenes permitidos (separados por comas)
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL (o usa DATABASE_URL=postgres://user:pass@host:5432/db)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=cambia_esto
PGDATABASE=mus_premium
PGSSL=false
# true = arrancar sin base de datos (modo invitado)
DB_DISABLED=false

# Reglas
OCHO_REYES=true
STONES_PER_GAME=40
GAMES_TO_WIN=3

# Reconexión (ms)
LOBBY_RECONNECT_MS=15000
GAME_RECONNECT_MS=90000
